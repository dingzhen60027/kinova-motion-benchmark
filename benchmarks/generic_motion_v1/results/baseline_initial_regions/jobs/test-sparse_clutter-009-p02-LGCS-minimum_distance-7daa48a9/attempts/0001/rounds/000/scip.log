# [type: char, advanced: FALSE, range: {om}, default: m]
conflict/reduction = m

# should apply the mixed binary reduction?
# [type: bool, advanced: TRUE, range: {TRUE,FALSE}, default: TRUE]
conflict/mbreduction = TRUE

