# should vars that do not feature in any constraints be removed at the end of the IIS process
# [type: bool, advanced: TRUE, range: {TRUE,FALSE}, default: TRUE]
iis/removeunusedvars = TRUE

# maximal time in seconds for all IIS finders to run
# [type: real, advanced: FALSE, range: [0,1e+20], default: 1e+20]
iis/time = 1e+20

# maximal number of nodes to process for all IIS finders (-1: no limit)
# [type: longint, advanced: FALSE, range: [-1,9223372036854775807], default: -1]
iis/nodes = -1

